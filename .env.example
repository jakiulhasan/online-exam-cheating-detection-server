# ---- Server ----
PORT=3000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
DB_USER=
DB_PASSWORD=
DB_NAME=medhaguard

# ---- Firebase Admin (secure token verification) ----
# Firebase Console -> Project Settings -> Service Accounts -> "Generate new private key".
# Paste the ENTIRE downloaded JSON as ONE line (keep it as valid JSON, keep the \n
# inside private_key escaped — the server un-escapes them automatically).
FB_SERVICE_ACCOUNT=

# ---- DEV ONLY ----
# If you have NOT set FB_SERVICE_ACCOUNT yet, set this to true to let the server
# accept Firebase tokens by DECODING them WITHOUT verifying the signature.
# This is insecure and must NEVER be enabled in production.
ALLOW_INSECURE_DEV_AUTH=false
